#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        gaming_layer_1 {
            display-name = "GL1";
            // | ESC       | 1         | 2         | 3               | 4            | 5              |                          | 6              | 7         | 8               | 9         | 0        | `         |
            // | TAB       | Q         | W         | E               | R            | T              |                          | Y              | U         | I               | O         | P        | -         |
            // | CTRL      | A         | S         | D               | F            | G              |                          | H              | J         | K               | L         | ;        | '         |
            // | SHIFT     | Z         | X         | C               | V            | B              | [         |   | ]        | N              | M         | ,               | .         | /        | SHIFT     |
            //                                     | ALT             | WIN          | GAME_LOWER     | SPACE     |   | ENTER    | GAME_RAISE     | BSPC      | DEL             |
            bindings = <
                 &kp ESC     &kp N1      &kp N2      &kp N3            &kp N4         &kp N5                                      &kp N6           &kp N7      &kp N8            &kp N9      &kp N0     &kp GRAVE
                 &kp TAB     &kp Q       &kp W       &kp E             &kp R          &kp T                                       &kp Y            &kp U       &kp I             &kp O       &kp P      &kp MINUS
                 &kp LCTRL   &kp A       &kp S       &kp D             &kp F          &kp G                                       &kp H            &kp J       &kp K             &kp L       &kp SEMI   &kp SQT
                 &kp LSHFT   &kp Z       &kp X       &kp C             &kp V          &kp B            &kp LBKT        &kp RBKT   &kp N            &kp M       &kp COMMA         &kp DOT     &kp FSLH   &kp RSHFT
                                                     &kp LALT          &kp LGUI       &mo GAME_LOWER   &kp SPACE       &kp RET    &mo GAME_RAISE   &kp BSPC    &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming_layer_2 {
            display-name = "GL2";
            // | ESC       | 1         | 2         | 3               | 4            | 5              |                          | 6              | 7         | 8               | 9         | 0        |           |
            // | F1        | F2        | F3        | F4              | F5           | F6             |                          | F7             | F8        | F9              | F10       | F11      | F12       |
            // | CTRL      | !         | @         | #               | $            | %              |                          | ^              | &         | *               | (         | )        | ~         |
            // | SHIFT     | HOME      | PG_UP     | PG_DN           | INS          |                |           |   |          | _              | =         | +               | {         | }        | |         |
            //                                     |                 |              |                |           |   |          |                |           |                 |
            bindings = <
                 &kp ESC     &kp N1      &kp N2      &kp N3            &kp N4         &kp N5                                      &kp N6           &kp N7      &kp N8            &kp N9      &kp N0     &trans
                 &kp F1      &kp F2      &kp F3      &kp F4            &kp F5         &kp F6                                      &kp F7           &kp F8      &kp F9            &kp F10     &kp F11    &kp F12
                 &kp LCTRL   &kp EXCL    &kp AT      &kp HASH          &kp DOLLAR     &kp PRCNT                                   &kp CARET        &kp AMPS    &kp KP_MULTIPLY   &kp LPAR    &kp RPAR   &kp TILDE
                 &kp LSHFT   &kp HOME    &kp PG_UP   &kp PG_DN         &kp INS        &trans           &trans          &trans     &kp UNDER        &kp EQUAL   &kp KP_PLUS       &kp LBRC    &kp RBRC   &kp PIPE
                                                     &trans            &trans         &trans           &trans          &trans     &trans           &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming_layer_3 {
            display-name = "GL3";
            // | ESC       | NUMLCK    | %         | *               | -            |                |                          |                |           |                 |           |          | CAPS      |
            // | TAB       | 7         | 8         | 9               | +            |                |                          |                | DEL       | UP              |           |          |           |
            // | CTRL      | 4         | 5         | 6               | =            |                |                          |                | LEFT      | DOWN            | RIGHT     |          |           |
            // | SHIFT     | 1         | 2         | 3               | .            |                |           |   |          |                |           |                 |           |          |           |
            //                                     |                 |              |                |           |   |          |                |           |                 |
            bindings = <
                 &kp ESC     &kp LNLCK   &kp PRCNT   &kp KP_MULTIPLY   &kp KP_MINUS   &trans                                      &trans           &trans      &trans            &trans      &trans     &kp CAPS
                 &kp TAB     &kp KP_N7   &kp KP_N8   &kp KP_N9         &kp KP_PLUS    &trans                                      &trans           &kp DEL     &kp UP            &trans      &trans     &trans
                 &kp LCTRL   &kp KP_N4   &kp KP_N5   &kp KP_N6         &kp EQUAL      &trans                                      &trans           &kp LEFT    &kp DOWN          &kp RIGHT   &trans     &trans
                 &kp LSHFT   &kp KP_N1   &kp KP_N2   &kp KP_N3         &kp KP_DOT     &trans           &trans          &trans     &trans           &trans      &trans            &trans      &trans     &trans
                                                     &trans            &trans         &trans           &trans          &trans     &trans           &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
