#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Bas";
            // | ESC       | 1              | 2            | 3                | 4                 | 5         |                          | 6         | 7               | 8                       | 9              | 0              | `         |
            // | TAB       | Q              | W            | E                | R                 | T         |                          | Y         | U               | I                       | O              | P              | -         |
            // | CTRL      | A/WIN          | S/ALT        | D/SHIFT          | F/CTRL            | G         |                          | H         | J/CTRL          | K/SHIFT                 | L/ALT          | ;/WIN          | '         |
            // | SHIFT     | Z              | X            | C                | V                 | B         | [         |   | ]        | N         | M               | ,                       | .              | /              | SHIFT     |
            //                                             | ALT              | WIN               | LOWER     | SPACE     |   | ENTER    | RAISE     | BSPC            | DEL                     |
            bindings = <
                 &kp ESC     &kp N1           &kp N2         &kp N3             &kp N4              &kp N5                                 &kp N6      &kp N7            &kp N8                    &kp N9           &kp N0           &kp GRAVE
                 &kp TAB     &kp Q            &kp W          &kp E              &kp R               &kp T                                  &kp Y       &kp U             &kp I                     &kp O            &kp P            &kp MINUS
                 &kp LCTRL   &hml LGUI A      &hml LALT S    &hml LSHIFT D      &hml LCTRL F        &kp G                                  &kp H       &hmr LCTRL J      &hmr LSHIFT K             &hmr LALT L      &hmr LGUI SEMI   &kp SQT
                 &kp LSHFT   &kp Z            &kp X          &kp C              &kp V               &kp B       &kp LBKT        &kp RBKT   &kp N       &kp M             &kp COMMA                 &kp DOT          &kp FSLH         &kp RSHFT
                                                             &kp LALT           &kp LGUI            &mo LOWER   &kp SPACE       &kp RET    &mo RAISE   &kp BSPC          &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Low";
            // | ESC       | PSCRN          | MUTE         | VOL-             | VOL+              | BRI-      |                          | BRI+      | PREV            | PLAY                    | NEXT           |                | \         |
            // | F1        | F2             | F3           | F4               | F5                | F6        |                          | F7        | F8              | F9                      | F10            | F11            | F12       |
            // | CTRL      | !/WIN          | @/ALT        | #/SHIFT          | $/CTRL            | %         |                          | ^         | &/CTRL          | */SHIFT                 | (/ALT          | )/WIN          | ~         |
            // | SHIFT     | HOME           | PG_UP        | PG_DN            | INS               |           |           |   |          | _         | =               | +                       | {              | }              | |         |
            //                                             |                  |                   |           |           |   |          |           |                 |                         |
            bindings = <
                 &kp ESC     &kp PSCRN        &kp C_MUTE     &kp C_VOL_DN       &kp C_VOL_UP        &kp C_BRI_DN                           &kp C_BRI_UP &kp C_PREV        &kp C_PP                  &kp C_NEXT       &trans           &kp BSLH
                 &kp F1      &kp F2           &kp F3         &kp F4             &kp F5              &kp F6                                 &kp F7       &kp F8            &kp F9                    &kp F10          &kp F11          &kp F12
                 &kp LCTRL   &hml LGUI EXCL   &hml LALT AT   &hml LSHIFT HASH   &hml LCTRL DOLLAR   &kp PRCNT                              &kp CARET    &hmr LCTRL AMPS   &hmr LSHIFT KP_MULTIPLY   &hmr LALT LPAR   &hmr LGUI RPAR   &kp TILDE
                 &kp LSHFT   &kp HOME         &kp PG_UP      &kp PG_DN          &kp INS             &trans      &trans          &trans     &kp UNDER    &kp EQUAL         &kp KP_PLUS               &kp LBRC         &kp RBRC         &kp PIPE
                                                             &trans             &trans              &trans      &trans          &trans     &trans      &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Rai";
            // | ESC       | /              | %            | *                | -                 |           |                          |           |                 |                         |                |                | CAPS      |
            // | TAB       | 7              | 8            | 9                | +                 |           |                          |           | PG_UP           | UP                      | PG_DN          |                |           |
            // | CTRL      | 4/WIN          | 5/ALT        | 6/SHIFT          | =/CTRL            |           |                          | HOME      | LEFT            | DOWN                    | RIGHT          | END            |           |
            // | SHIFT     | 1              | 2            | 3                | .                 |           |           |   |          |           |                 |                         |                |                |           |
            //                                             |                  |                   |           |           |   |          |           |                 |                         |
            bindings = <
                 &kp ESC     &kp KP_DIVIDE    &kp PRCNT      &kp KP_MULTIPLY    &kp KP_MINUS        &trans                                 &trans      &trans            &trans                    &trans           &trans           &kp CAPS
                 &kp TAB     &kp N7           &kp N8         &kp N9             &kp KP_PLUS         &trans                                 &trans      &kp PG_UP         &kp UP                    &kp PG_DN        &trans           &trans
                 &kp LCTRL   &hml LGUI N4     &hml LALT N5   &hml LSHIFT N6     &hml LCTRL EQUAL    &trans                                 &kp HOME    &kp LEFT          &kp DOWN                  &kp RIGHT        &kp END          &trans
                 &kp LSHFT   &kp N1           &kp N2         &kp N3             &kp KP_DOT          &trans      &trans          &trans     &trans      &trans            &trans                    &trans           &trans           &trans
                                                             &trans             &trans              &trans      &trans          &trans     &trans      &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

    };
};
